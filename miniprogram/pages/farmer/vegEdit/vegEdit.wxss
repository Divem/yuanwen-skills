.veg-edit { padding: 32rpx; }
.form-item { margin-bottom: 28rpx; }
.form-label { font-size: 26rpx; font-weight: bold; display: block; margin-bottom: 8rpx; }
.form-input { border: 2rpx solid #eee; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.form-textarea { border: 2rpx solid #eee; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; width: 100%; height: 160rpx; box-sizing: border-box; }
.form-row { display: flex; gap: 20rpx; }
.form-item.half { flex: 1; }
.cover-picker { width: 200rpx; height: 200rpx; }
.cover-preview { width: 100%; height: 100%; border-radius: 12rpx; }
.cover-placeholder { width: 100%; height: 100%; border: 2rpx dashed #ccc; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; color: #999; font-size: 24rpx; }
.status-toggle { display: flex; justify-content: space-between; align-items: center; background: #f5f5f5; padding: 20rpx; border-radius: 12rpx; }
.toggle-btn { color: #E91E63; font-size: 26rpx; }
.submit-btn { margin-top: 40rpx; background: #E91E63 !important; color: #fff !important; border-radius: 40rpx !important; }
.submit-btn[disabled] { background: #ccc !important; }