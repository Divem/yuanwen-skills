<view class="profile">
  <view class="user-header">
    <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" />
    <view class="user-info">
      <text class="nickname">{{userInfo.nickName || '种点什么用户'}}</text>
    </view>
  </view>
  <view class="menu-list">
    <view class="menu-item" bindtap="goToOrders">
      <text>我的订单</text><text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="onSwitchToFarmer">
      <text>{{isFarmer ? '切换为菜农身份' : '成为菜农（需邀请码）'}}</text><text class="menu-arrow">></text>
    </view>
    <button class="menu-item contact-btn" open-type="contact">
      <text>联系客服</text><text class="menu-arrow">></text>
    </button>
    <view class="menu-item"><text>关于我们</text><text class="menu-arrow">></text></view>
  </view>
</view>
