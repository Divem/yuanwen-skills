<view class="tabbar">
  <view
    class="tabbar-item {{active === index ? 'active' : ''}}"
    wx:for="{{tabs}}"
    wx:key="index"
    data-index="{{index}}"
    bindtap="onTabTap"
  >
    <text class="tabbar-icon">{{item.icon}}</text>
    <text class="tabbar-text">{{item.text}}</text>
  </view>
</view>
